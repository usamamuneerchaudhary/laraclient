{
    "name": "usamamuneerchaudhary/laraclient",
    "description": "Configure every third-party API your Laravel app talks to in one file, then see every call in one dashboard.",
    "keywords": ["laravel", "api", "api-client", "http", "guzzle", "rate-limiting", "circuit-breaker", "openapi"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Usama Muneer",
            "email": "hello@usamamuneer.me",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.9",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "symfony/yaml": "^7.4|^8.0"
    },
    "suggest": {
        "laravel/pulse": "Adds a LaraClient card to your Pulse dashboard (^2.0)",
        "symfony/yaml": "Required to scaffold clients from YAML OpenAPI specs",
        "open-telemetry/api": "Emits an OpenTelemetry span per outbound request"
    },
    "autoload": {
        "psr-4": {
            "Usamamuneerchaudhary\\LaraClient\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Usamamuneerchaudhary\\LaraClient\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Usamamuneerchaudhary\\LaraClient\\LaraClientServiceProvider"
            ],
            "aliases": {
                "LaraClient": "Usamamuneerchaudhary\\LaraClient\\Facades\\LaraClient"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
